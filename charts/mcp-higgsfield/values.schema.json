{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "team": {"type": "string"},
    "tenant": {"type": "string"},
    "enabled": {"type": "boolean"},
    "nameOverride": {"type": "string", "maxLength": 63, "pattern": "^[a-z0-9-]*$"},
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "higgsfield": {
      "type": "object",
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "extraEnv": {"type": "object"}
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["kubernetes", "externalSecret"]},
        "apiKey": {"type": "string", "title": "Higgsfield API key"},
        "apiSecret": {"type": "string", "title": "Higgsfield API secret"},
        "existingSecret": {"type": "string"},
        "externalSecret": {"type": "object"}
      }
    },
    "port": {"type": "integer"},
    "timeout": {"type": "string"},
    "mcp": {"type": "object"},
    "agentgatewayBackend": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}, "labels": {"type": "object"}}
    },
    "remoteMCPServer": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "url": {"type": "string"},
        "allowedNamespaces": {"type": "string", "enum": ["Same", "All"]}
      }
    },
    "resources": {"type": "object"},
    "networkPolicy": {"type": "object"}
  }
}
