{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "route": {
      "type": "object",
      "properties": {
        "hostname": {"type": "string", "title": "Hostname", "description": "Leave empty for a generated hostname"}
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "size": {"type": "string", "title": "Data volume size"},
        "storageClassName": {"type": "string", "title": "Storage class"}
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["kubernetes", "externalSecret"], "title": "Secret source"},
        "initialPassword": {"type": "string", "title": "Initial dashboard password", "description": "Leave empty to generate one"}
      }
    }
  }
}
