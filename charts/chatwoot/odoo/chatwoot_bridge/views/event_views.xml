<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bridge_event_list" model="ir.ui.view">
        <field name="name">chatwoot.bridge.event.list</field>
        <field name="model">chatwoot.bridge.event</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="state == 'failed'" decoration-muted="state == 'sent'">
                <field name="create_date"/>
                <field name="event"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="state"/>
                <field name="attempts"/>
                <field name="next_attempt"/>
                <field name="last_error"/>
                <button name="action_retry" type="object" string="Retry" icon="fa-repeat" invisible="state == 'sent'"/>
            </list>
        </field>
    </record>

    <record id="view_bridge_event_form" model="ir.ui.view">
        <field name="name">chatwoot.bridge.event.form</field>
        <field name="model">chatwoot.bridge.event</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <button name="action_retry" type="object" string="Retry" invisible="state == 'sent'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="message_id"/>
                            <field name="idempotency_key"/>
                        </group>
                        <group>
                            <field name="attempts"/>
                            <field name="next_attempt"/>
                            <field name="last_error"/>
                            <field name="last_delivery"/>
                            <field name="sent_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bridge_event_search" model="ir.ui.view">
        <field name="name">chatwoot.bridge.event.search</field>
        <field name="model">chatwoot.bridge.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="idempotency_key"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="unsent" string="Not sent" domain="[('state', '!=', 'sent')]"/>
            </search>
        </field>
    </record>

    <record id="action_bridge_events" model="ir.actions.act_window">
        <field name="name">Chatwoot bridge events</field>
        <field name="res_model">chatwoot.bridge.event</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_unsent': 1}</field>
    </record>

    <menuitem id="menu_bridge_events" name="Chatwoot bridge events" parent="base.menu_automation"
              action="action_bridge_events" groups="base.group_system" sequence="90"/>
</odoo>
