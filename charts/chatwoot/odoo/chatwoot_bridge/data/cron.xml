<?xml version="1.0" encoding="utf-8"?>
<!-- noupdate: an upgrade keeps a cron that staff switched off -->
<odoo noupdate="1">
    <!-- Triggered on every queued event; the interval catches up after a restart -->
    <record id="cron_deliver_events" model="ir.cron">
        <field name="name">Chatwoot bridge: deliver events</field>
        <field name="model_id" ref="model_chatwoot_bridge_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_deliver()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
