{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "route": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string",
          "title": "Hostname",
          "description": "Leave empty for a generated hostname"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "account": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "title": "Account name"
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "adminEmail": {
          "type": "string",
          "title": "Super admin email",
          "description": "An address under .invalid; leave empty for superadmin@chatwoot.invalid"
        }
      }
    },
    "signature": {
      "type": "object",
      "title": "Message signature",
      "properties": {
        "text": {
          "type": "string",
          "title": "Signature",
          "description": "Markdown; {name} becomes the staff member's name. Empty: none"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^Channel::[A-Za-z]+$"
          }
        }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "title": "Web pods"
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "title": "Worker pods"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "database": {
      "type": "object",
      "properties": {
        "instances": {
          "type": "integer",
          "minimum": 1,
          "title": "Database instances",
          "description": "2 or more adds a standby"
        },
        "size": {
          "type": "string",
          "title": "Database volume size"
        },
        "storageClassName": {
          "type": "string",
          "title": "Database storage class"
        },
        "imageName": {
          "type": "string",
          "minLength": 1,
          "description": "A PostgreSQL image with pgvector"
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string",
          "title": "Store volume size"
        },
        "storageClassName": {
          "type": "string",
          "title": "Store storage class"
        }
      }
    },
    "attachments": {
      "type": "object",
      "properties": {
        "storage": {
          "type": "string",
          "enum": [
            "volume",
            "objectBucketClaim"
          ],
          "title": "Attachment storage"
        },
        "volume": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "title": "Attachment volume size"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "objectBucketClaim": {
          "type": "object",
          "properties": {
            "storageClassName": {
              "type": "string",
              "title": "Bucket storage class"
            },
            "region": {
              "type": "string"
            },
            "caConfigMap": {
              "type": "string"
            }
          }
        }
      }
    },
    "sso": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Single sign-on"
        },
        "issuerUrl": {
          "type": "string",
          "title": "OIDC issuer"
        },
        "clientId": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "groupsClaim": {
          "type": "string"
        },
        "allowedGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "title": "Groups that may log in"
        },
        "adminGroups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Groups that administer",
          "description": "An empty entry is ignored"
        },
        "emailDomains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deniedEmails": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          },
          "title": "Addresses that may not log in"
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "session": {
          "type": "object",
          "properties": {
            "refresh": {
              "type": "string",
              "pattern": "^[0-9]+(s|m|h)$",
              "title": "Group re-check interval"
            },
            "expire": {
              "type": "string",
              "pattern": "^[0-9]+(s|m|h)$",
              "title": "Login session lifetime"
            },
            "chatwootHours": {
              "type": "integer",
              "minimum": 25,
              "maximum": 720,
              "title": "Chatwoot session hours"
            }
          }
        },
        "public": {
          "type": "object",
          "properties": {
            "widget": {
              "type": "boolean",
              "title": "Website live chat widget"
            },
            "inboxApi": {
              "type": "boolean"
            },
            "surveys": {
              "type": "boolean"
            },
            "helpCenter": {
              "type": "boolean"
            },
            "customerPage": {
              "type": "object",
              "title": "Customer page at / of the host",
              "properties": {
                "enabled": {"type": "boolean"},
                "inbox": {"type": "string", "title": "Website inbox of the page"},
                "title": {"type": "string"},
                "portalUrl": {"type": "string", "title": "https address of the customer portal", "pattern": "^(https://.+)?$"},
                "portalText": {"type": "string"},
                "login": {
                  "type": "object",
                  "title": "Customer login (OIDC public client with PKCE)",
                  "properties": {
                    "issuerUrl": {"type": "string", "pattern": "^(https://.+)?$"},
                    "clientId": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "webIngressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "dnsPeers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "agentEgress": {
          "type": "object",
          "properties": {
            "to": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "apiServerEgress": {
          "type": "object",
          "properties": {
            "to": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "title": "Monitoring",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "ServiceMonitor of the Odoo bridge"
        },
        "alerts": {
          "type": "boolean",
          "title": "Alert rules of the Odoo bridge"
        },
        "namespaceLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "odoo": {
      "type": "object",
      "title": "Odoo bridge",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Mirror Odoo tickets and leads",
          "description": "Odoo tickets and leads as conversations in Chatwoot API inboxes; needs route.hostname"
        },
        "url": {
          "type": "string",
          "title": "Odoo address",
          "pattern": "^(https://.*)?$"
        },
        "database": {
          "type": "string",
          "title": "Odoo database"
        },
        "ticketInbox": {
          "type": "string",
          "title": "Inbox of tickets"
        },
        "leadInbox": {
          "type": "string",
          "title": "Inbox of leads",
          "description": "Empty: leads are not mirrored"
        },
        "solvedStage": {
          "type": "string",
          "title": "Stage of a resolved ticket"
        },
        "website": {
          "type": "object",
          "title": "Website chats as Odoo tickets",
          "properties": {
            "enabled": {"type": "boolean"},
            "inbox": {"type": "string", "title": "Website inbox"},
            "url": {"type": "string", "title": "https address of the site with the widget"},
            "team": {"type": "string", "title": "Helpdesk team of chat tickets"},
            "ticketsPerEmail": {"type": "integer", "minimum": 1},
            "ticketsPerHour": {"type": "integer", "minimum": 1},
            "visitorPartner": {"type": "string", "title": "Odoo partner of unverified chat tickets", "minLength": 1},
            "conversationsPerMinute": {"type": "integer", "minimum": 1},
            "salesLabel": {"type": "string", "title": "Label that moves a chat to a lead", "pattern": "^([A-Za-z0-9_-]{1,64})?$"},
            "cancelledStage": {"type": "string", "title": "Stage of a ticket whose chat moved to a lead"},
            "preChatMessage": {"type": "string", "title": "Message above the pre-chat form (Markdown)"},
            "identity": {
              "type": "object",
              "title": "Identity validation of logged-in customers",
              "properties": {
                "enabled": {"type": "boolean"},
                "records": {"type": "boolean", "title": "The bot's agent gets the customer's own Odoo records"}
              }
            }
          }
        },
        "sales": {
          "type": "object",
          "title": "Leads from the sales label",
          "properties": {
            "fromSupport": {"type": "boolean", "title": "The sales label also moves a support conversation"},
            "team": {"type": "string", "title": "CRM team of the leads"}
          },
          "additionalProperties": false
        },
        "panel": {
          "type": "object",
          "title": "Odoo side panel",
          "properties": {
            "enabled": {"type": "boolean", "title": "Show the Odoo panel", "description": "Partner, orders, subscriptions, tickets, opportunities and linked issues next to a conversation; needs sso.enabled"},
            "title": {"type": "string", "title": "Tab name", "minLength": 1},
            "issues": {
              "type": "object",
              "title": "Linked issues",
              "properties": {
                "url": {"type": "string", "title": "Jira address", "pattern": "^(https://[^/?#]+(/[^?#]*)?)?$"},
                "user": {"type": "string", "title": "Jira account email (Cloud)"}
              }
            }
          }
        },
        "bridge": {
          "type": "object",
          "properties": {
            "image": {
              "type": "string"
            },
            "resources": {
              "type": "object"
            }
          }
        }
      }
    },
    "draftAgent": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "AI drafts of the next reply as private notes"
        },
        "inboxes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "string"
        },
        "sweepSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "sweepMaxAgeHours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "triage": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "A category label, a team and a summary note for each new conversation of the draft inboxes"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,64}$"
              },
              "team": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "fallback": {
          "type": "string"
        },
        "teams": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "label": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}$"
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "string"
        }
      }
    },
    "tenantFacts": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Facts about the contact's tenant from the Kubernetes API in the triage note"
        },
        "emailAnnotation": {
          "type": "string"
        },
        "tenantLabel": {
          "type": "string"
        },
        "veleroNamespace": {
          "type": "string"
        },
        "eventHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ignoreEventReasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "title": "A2A agent of the bot and the panel",
      "properties": {
        "url": {
          "type": "string",
          "title": "Agent address",
          "description": "JSON-RPC address of the A2A agent",
          "pattern": "^(https?://.*)?$"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 10
        },
        "auth": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "none",
                "serviceAccountToken",
                "clientAssertion",
                "clientSecret"
              ],
              "title": "Credential"
            },
            "audience": {
              "type": "string"
            },
            "tokenUrl": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            }
          }
        }
      }
    },
    "agentBot": {
      "type": "object",
      "title": "Agent Bot",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Answer customers through the agent until a person takes over"
        },
        "name": {
          "type": "string"
        },
        "inboxes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Inbox names; * is every inbox"
        },
        "instructions": {
          "type": "string"
        },
        "handoff": {
          "type": "object",
          "properties": {
            "keywords": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "marker": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        },
        "failureMessage": {
          "type": "string"
        },
        "quotations": {
          "type": "object",
          "title": "QUOTE answers of the agent become Odoo quotations",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "marker": {"type": "string", "pattern": "^[A-Z][A-Z_]{2,31}$"},
            "sentMessage": {"type": "string", "minLength": 1},
            "refusedMessage": {"type": "string", "minLength": 1}
          }
        },
        "agentUrl": {
          "type": "string",
          "description": "A2A address of the bot's own agent; empty: agent.url"
        }
      }
    },
    "copilotPanel": {
      "type": "object",
      "title": "Agent panel",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "A sidebar panel where staff ask the agent; needs sso.enabled"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "mcp": {
      "type": "object",
      "title": "MCP server",
      "properties": {
        "enabled": {"type": "boolean", "description": "Tools for AI agents: list and read conversations, post private notes; never a reply to a contact"},
        "image": {
          "type": "object",
          "properties": {
            "repository": {"type": "string", "description": "chatwoot-mcp image; required with mcp.enabled"},
            "tag": {"type": "string"},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "accountId": {"type": "integer", "minimum": 1},
        "noteInboxIds": {"type": "array", "items": {"type": "integer", "minimum": 1}, "description": "Inboxes post_private_note may write to; empty: every inbox of the MCP user"},
        "organization": {"type": "string", "description": "Organisation the server's instructions name the support desk after"},
        "targetName": {"type": "string", "pattern": "^[a-z0-9_-]{1,64}$"},
        "callers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "name", "namespace"],
            "properties": {
              "kind": {"type": "string", "enum": ["ServiceAccount"]},
              "name": {"type": "string", "minLength": 1},
              "namespace": {"type": "string", "minLength": 1}
            }
          }
        },
        "callerAccount": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean", "description": "ServiceAccount chatwoot-mcp-caller with a long-lived token, for a gateway outside the cluster"}
          }
        },
        "route": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "hostname": {"type": "string"},
            "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "allowedHosts": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9.-]+(:[0-9*]+)?$"}, "description": "Further Host headers the server answers; required for a Route without hostname"},
        "ingressFrom": {"type": "array", "items": {"type": "object"}},
        "rbacProxy": {
          "type": "object",
          "properties": {
            "image": {"type": "string", "minLength": 1},
            "resources": {"type": "object"}
          }
        },
        "resources": {"type": "object"}
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "kubernetes",
            "externalSecret"
          ],
          "title": "Secret source"
        },
        "secretKeyBase": {
          "type": "string",
          "description": "Leave empty to generate one. Never change it afterwards"
        },
        "redisPassword": {
          "type": "string"
        },
        "superAdminPassword": {
          "type": "string"
        },
        "platformToken": {
          "type": "string"
        },
        "oauthClientSecret": {
          "type": "string"
        },
        "oauthCookieSecret": {
          "type": "string",
          "description": "16, 24 or 32 characters",
          "pattern": "^(.{16}|.{24}|.{32})?$"
        },
        "agentBotToken": {
          "type": "string",
          "description": "Leave empty to generate one; at least 32 characters"
        },
        "agentBotWebhookSecret": {
          "type": "string",
          "description": "Leave empty to generate one; at least 32 characters"
        },
        "odooApiKey": {
          "type": "string",
          "description": "API key of the Odoo user the bridge works as; required with odoo.enabled"
        },
        "odooEventSecret": {
          "type": "string",
          "description": "Leave empty to generate one, then give Odoo the same value; at least 32 characters",
          "pattern": "^(.{32,})?$"
        },
        "odooBridgeToken": {
          "type": "string",
          "description": "Leave empty to generate one; at least 32 characters",
          "pattern": "^(.{32,})?$"
        },
        "odooInboxSecret": {
          "type": "string",
          "description": "Leave empty to generate one; at least 32 characters",
          "pattern": "^(.{32,})?$"
        },
        "issueTrackerToken": {
          "type": "string",
          "description": "API token of the Jira site, with odoo.panel.issues.url"
        },
        "websiteIdentityKey": {
          "type": "string",
          "description": "Identity validation key of the Website inbox, with odoo.website.identity.enabled"
        },
        "draftToken": {
          "type": "string"
        },
        "draftWebhookSecret": {
          "type": "string"
        },
        "agentClientSecret": {
          "type": "string"
        },
        "mcpToken": {
          "type": "string",
          "description": "Access token of the Chatwoot agent user the MCP server works as; required with mcp.enabled"
        }
      }
    }
  }
}
