{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "route": {
      "type": "object",
      "properties": {
        "hostname": {"type": "string", "title": "Hostname", "description": "Leave empty for a generated hostname"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "account": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1, "title": "Account name"},
        "id": {"type": "integer", "minimum": 1},
        "adminEmail": {"type": "string", "title": "Super admin email", "description": "An address under .invalid; leave empty for superadmin@chatwoot.invalid"}
      }
    },
    "web": {"type": "object", "properties": {"replicas": {"type": "integer", "minimum": 1, "title": "Web pods"}}},
    "worker": {
      "type": "object",
      "properties": {
        "replicas": {"type": "integer", "minimum": 1, "title": "Worker pods"},
        "concurrency": {"type": "integer", "minimum": 1}
      }
    },
    "extraEnv": {"type": "array"},
    "database": {
      "type": "object",
      "properties": {
        "instances": {"type": "integer", "minimum": 1, "title": "Database instances", "description": "2 or more adds a standby"},
        "size": {"type": "string", "title": "Database volume size"},
        "storageClassName": {"type": "string", "title": "Database storage class"},
        "imageName": {"type": "string", "minLength": 1, "description": "A PostgreSQL image with pgvector"}
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "size": {"type": "string", "title": "Store volume size"},
        "storageClassName": {"type": "string", "title": "Store storage class"}
      }
    },
    "attachments": {
      "type": "object",
      "properties": {
        "storage": {"type": "string", "enum": ["volume", "objectBucketClaim"], "title": "Attachment storage"},
        "volume": {
          "type": "object",
          "properties": {
            "size": {"type": "string", "title": "Attachment volume size"},
            "storageClassName": {"type": "string"}
          }
        },
        "objectBucketClaim": {
          "type": "object",
          "properties": {
            "storageClassName": {"type": "string", "title": "Bucket storage class"},
            "region": {"type": "string"},
            "caConfigMap": {"type": "string"}
          }
        }
      }
    },
    "sso": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean", "title": "Single sign-on"},
        "issuerUrl": {"type": "string", "title": "OIDC issuer"},
        "clientId": {"type": "string"},
        "scope": {"type": "string"},
        "groupsClaim": {"type": "string"},
        "allowedGroups": {"type": "array", "items": {"type": "string", "minLength": 1}, "title": "Groups that may log in"},
        "adminGroups": {"type": "array", "items": {"type": "string"}, "title": "Groups that administer", "description": "An empty entry is ignored"},
        "emailDomains": {"type": "array", "items": {"type": "string"}},
        "extraArgs": {"type": "array", "items": {"type": "string"}},
        "session": {
          "type": "object",
          "properties": {
            "refresh": {"type": "string", "pattern": "^[0-9]+(s|m|h)$", "title": "Group re-check interval"},
            "expire": {"type": "string", "pattern": "^[0-9]+(s|m|h)$", "title": "Login session lifetime"},
            "chatwootHours": {"type": "integer", "minimum": 25, "maximum": 720, "title": "Chatwoot session hours"}
          }
        },
        "public": {
          "type": "object",
          "properties": {
            "widget": {"type": "boolean", "title": "Website live chat widget"},
            "inboxApi": {"type": "boolean"},
            "surveys": {"type": "boolean"},
            "helpCenter": {"type": "boolean"}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "webIngressFrom": {"type": "array", "items": {"type": "object"}}
      }
    },
    "odoo": {"type": "object", "properties": {"enabled": {"type": "boolean", "description": "Reserved for a later version; must stay false"}}},
    "draftAgent": {"type": "object", "properties": {"enabled": {"type": "boolean", "description": "Reserved for a later version; must stay false"}}},
    "secrets": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["kubernetes", "externalSecret"], "title": "Secret source"},
        "secretKeyBase": {"type": "string", "description": "Leave empty to generate one. Never change it afterwards"},
        "redisPassword": {"type": "string"},
        "superAdminPassword": {"type": "string"},
        "platformToken": {"type": "string"},
        "oauthClientSecret": {"type": "string"},
        "oauthCookieSecret": {"type": "string", "description": "16, 24 or 32 characters", "pattern": "^(.{16}|.{24}|.{32})?$"}
      }
    }
  }
}
