{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "team": {
      "type": "string"
    },
    "tenant": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "officeagent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maximumTotalBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "allowCreation": {
          "type": "boolean"
        },
        "allowRegistration": {
          "type": "boolean"
        },
        "allowInlineContent": {
          "type": "boolean"
        },
        "requirePlanSnapshot": {
          "type": "boolean"
        },
        "strictToolSchemas": {
          "type": "boolean"
        },
        "calculateFormulas": {
          "type": "boolean"
        }
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "connectionId": {
          "type": "string",
          "minLength": 1
        },
        "allowedExtensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\.[a-z0-9]+$"
          }
        },
        "defaultChangeMode": {
          "type": "string",
          "enum": [
            "Direct",
            "Tracked"
          ]
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 1
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingClaim": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClass": {
              "type": "string"
            },
            "accessMode": {
              "type": "string",
              "enum": [
                "ReadWriteOnce",
                "ReadWriteOncePod",
                "ReadWriteMany"
              ]
            }
          }
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535,
      "not": {
        "enum": [
          8080,
          8443
        ]
      }
    },
    "runAsUser": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appProtocol": {
          "type": "string"
        },
        "labelDomain": {
          "type": "string",
          "minLength": 1
        },
        "server": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "bundle": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressNamespaces": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dnsNamespace": {
              "type": "string"
            },
            "dnsPort": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
