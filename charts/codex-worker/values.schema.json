{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "gitlab", "gateway", "authStore", "secrets", "storage", "tls", "networkPolicy", "monitoring", "resources", "terminationGracePeriodSeconds"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy", "pullSecrets"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"},
        "tag": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$", "not": {"enum": ["latest"]}},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "pullSecrets": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["name"],
          "properties": {"name": {"$ref": "#/definitions/requiredName"}}
        }}
      }
    },
    "gitlab": {
      "type": "object", "additionalProperties": false, "required": ["apiV4Url", "projectId"],
      "properties": {
        "apiV4Url": {"type": "string", "pattern": "^https://[^\\s/?#@]+/api/v4$"},
        "projectId": {"$ref": "#/definitions/projectId"}
      }
    },
    "gateway": {
      "type": "object", "additionalProperties": false, "required": ["url", "model"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://[^\\s/?#@]+(/[^\\s?#]*[^\\s/?#])?$"},
        "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
      }
    },
    "authStore": {
      "type": "object", "additionalProperties": false, "required": ["projectId"],
      "properties": {"projectId": {"$ref": "#/definitions/projectId"}}
    },
    "secrets": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "workerTokenSecret", "authStoreTokenSecret", "gatewayKeySecret", "externalSecret"],
      "properties": {
        "type": {"enum": ["kubernetes", "externalSecret"]},
        "workerTokenSecret": {"$ref": "#/definitions/optionalName"},
        "authStoreTokenSecret": {"$ref": "#/definitions/optionalName"},
        "gatewayKeySecret": {"$ref": "#/definitions/optionalName"},
        "externalSecret": {
          "type": "object", "additionalProperties": false,
          "required": ["storeName", "storeKind", "refreshInterval", "items"],
          "properties": {
            "storeName": {"$ref": "#/definitions/optionalName"},
            "storeKind": {"enum": ["SecretStore", "ClusterSecretStore"]},
            "refreshInterval": {"$ref": "#/definitions/duration"},
            "items": {
              "type": "object", "additionalProperties": false, "required": ["workerToken", "authStoreToken", "gatewayKey"],
              "properties": {
                "workerToken": {"$ref": "#/definitions/remoteRef"},
                "authStoreToken": {"$ref": "#/definitions/remoteRef"},
                "gatewayKey": {"$ref": "#/definitions/remoteRef"}
              }
            }
          }
        }
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["existingClaim", "storageClass", "size", "accessMode"],
      "properties": {
        "existingClaim": {"$ref": "#/definitions/optionalName"},
        "storageClass": {"$ref": "#/definitions/optionalName"},
        "size": {"$ref": "#/definitions/quantity"},
        "accessMode": {"enum": ["ReadWriteOncePod", "ReadWriteOnce"]}
      }
    },
    "tls": {
      "type": "object", "additionalProperties": false,
      "required": ["openshift", "existingSecret", "caConfigMap"],
      "properties": {
        "openshift": {
          "type": "object", "additionalProperties": false, "required": ["enabled", "injectServiceCa"],
          "properties": {"enabled": {"type": "boolean"}, "injectServiceCa": {"type": "boolean"}}
        },
        "existingSecret": {"$ref": "#/definitions/optionalName"},
        "caConfigMap": {
          "type": "object", "additionalProperties": false, "required": ["name", "key"],
          "properties": {
            "name": {"$ref": "#/definitions/optionalName"},
            "key": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9._-]+$"}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "runnerNamespaceSelector", "monitoringNamespaceSelector", "egress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "runnerNamespaceSelector": {"$ref": "#/definitions/selector"},
        "monitoringNamespaceSelector": {"$ref": "#/definitions/selector"},
        "egress": {
          "type": "object", "additionalProperties": false,
          "required": ["dnsNamespaceSelector", "dnsPorts", "httpsCidrs"],
          "properties": {
            "dnsNamespaceSelector": {"$ref": "#/definitions/selector"},
            "dnsPorts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
            "httpsCidrs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}}
          }
        }
      }
    },
    "monitoring": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "interval", "rules"],
      "properties": {
        "enabled": {"type": "boolean"},
        "interval": {"$ref": "#/definitions/duration"},
        "rules": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "runbookUrl", "failureWindow", "failureFor", "stallAgeSeconds", "stallFor", "unavailableFor"],
          "properties": {
            "enabled": {"type": "boolean"},
            "runbookUrl": {"type": "string", "pattern": "^(|https://[^\\s#]+)$"},
            "failureWindow": {"$ref": "#/definitions/duration"},
            "failureFor": {"$ref": "#/definitions/duration"},
            "stallAgeSeconds": {"type": "integer", "minimum": 1},
            "stallFor": {"$ref": "#/definitions/duration"},
            "unavailableFor": {"$ref": "#/definitions/duration"}
          }
        }
      }
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object", "additionalProperties": false, "required": ["cpu", "memory"],
          "properties": {"cpu": {"$ref": "#/definitions/quantity"}, "memory": {"$ref": "#/definitions/quantity"}}
        },
        "limits": {
          "type": "object", "additionalProperties": false, "required": ["memory"],
          "properties": {"cpu": {"$ref": "#/definitions/quantity"}, "memory": {"$ref": "#/definitions/quantity"}}
        }
      }
    }
  },
  "definitions": {
    "requiredName": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
    "optionalName": {"type": "string", "maxLength": 253, "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$"},
    "projectId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "quantity": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?([EPTGMK]i?|m|k)?$"},
    "duration": {"type": "string", "pattern": "^([1-9][0-9]*(ms|s|m|h|d|w|y))+$"},
    "remoteRef": {
      "type": "object", "additionalProperties": false, "required": ["key", "property"],
      "properties": {"key": {"type": "string"}, "property": {"type": "string", "minLength": 1}}
    },
    "selector": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "matchLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "matchExpressions": {
          "type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false, "required": ["key", "operator"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "operator": {"enum": ["In", "NotIn", "Exists", "DoesNotExist"]},
              "values": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
