{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "agent": {
      "type": "object",
      "properties": {
        "opencode": {
          "type": "object",
          "properties": {
            "plugins": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "contains": {
                "type": "string",
                "pattern": "^oh-my-openagent@"
              }
            }
          }
        }
      }
    }
  }
}
