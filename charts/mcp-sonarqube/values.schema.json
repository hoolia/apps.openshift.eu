{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "team": {"type": "string"},
    "tenant": {"type": "string"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "sonarqube": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string"},
        "readOnly": {"type": "boolean"},
        "toolsets": {"type": "string"}
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["perCaller", "broker"]},
        "gatewayHeader": {"type": "string"}
      }
    },
    "broker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "not": {"enum": [80, 443, 8080, 8443]}},
        "adminTokenSecret": {"type": "string"},
        "adminTokenKey": {"type": "string", "minLength": 1},
        "issuers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["issuer", "jwksUri"],
            "properties": {
              "issuer": {"type": "string", "minLength": 1},
              "jwksUri": {"type": "string", "minLength": 1},
              "kind": {"enum": ["oidc", "kubernetes"]},
              "audiences": {"type": "array", "items": {"type": "string"}},
              "caFile": {"type": "string"}
            }
          }
        },
        "cluster": {"type": "string"},
        "allowedIdentity": {"type": "string"},
        "groups": {"type": "array", "items": {"type": "string"}},
        "tokenDays": {"type": "integer", "minimum": 2},
        "identityProvider": {"enum": ["sonarqube", "oidc"]},
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "providerKey": {"type": "string", "minLength": 1},
            "groupsClaim": {"type": "string", "minLength": 1},
            "groupPrefix": {"type": "string", "pattern": "^([A-Za-z0-9][A-Za-z0-9._-]*)?$"}
          }
        },
        "resources": {"type": "object"}
      }
    },
    "port": {"type": "integer", "not": {"enum": [80, 443, 8080, 8443]}},
    "path": {"type": "string"},
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appProtocol": {"type": "string"},
        "targetName": {"type": "string", "minLength": 1},
        "server": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "bundle": {"type": "string"}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {"type": "object"},
        "annotations": {"type": "object"}
      }
    },
    "podLabels": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "resources": {"type": "object"},
    "networkPolicy": {"type": "object"}
  }
}
