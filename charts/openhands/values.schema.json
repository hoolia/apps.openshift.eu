{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "build": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "cliImage": {"type": "string", "minLength": 1},
        "versions": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}},
        "output": {
          "type": "object",
          "properties": {
            "kind": {"type": "string", "enum": ["ImageStreamTag", "DockerImage"]},
            "name": {"type": "string"},
            "pushSecret": {"type": "string"}
          }
        }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "host": {"type": "string"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "timeout": {"type": "string", "pattern": "^[0-9]+(s|m|h)$"}
      }
    },
    "oauth": {
      "type": "object",
      "properties": {
        "allowedGroups": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["kubernetes", "externalSecret"]}
      }
    },
    "git": {
      "type": "object",
      "properties": {
        "host": {"type": "string", "pattern": "^$|^[a-z0-9.-]+(:[0-9]+)?$"}
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "upstream": {"type": "string", "pattern": "^$|^https?://"}
      }
    },
    "mcpServers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "path": {"type": "string", "pattern": "^/"},
          "timeout": {"type": "integer", "minimum": 1}
        }
      }
    },
    "env": {"type": "object", "additionalProperties": {"type": "string"}},
    "storage": {
      "type": "object",
      "properties": {
        "accessMode": {"type": "string", "enum": ["ReadWriteOnce", "ReadWriteMany"]}
      }
    }
  }
}
