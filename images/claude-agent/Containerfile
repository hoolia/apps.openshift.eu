# image with the command-line tools of the platform (oc, kubectl, helm, glab, gh, ...);
# the build passes it, for example an opencode-agent image
ARG TOOLS_IMAGE
FROM ${TOOLS_IMAGE} AS tools
USER 0
# its binaries, without its own agent (opencode is built for musl); Python and npm tools
# are installed below, so links into their environments stay behind
RUN set -eu; mkdir -p /export/bin; \
    for f in /usr/local/bin/*; do \
      n=$(basename "$f"); \
      case "$n" in opencode|opencode2|node|npm|npx|corepack|yarn|yarnpkg) continue;; esac; \
      if [ -L "$f" ]; then \
        case "$(readlink -f "$f")" in /usr/local/go/*) cp -P "$f" /export/bin/;; esac; \
        continue; \
      fi; \
      if head -c 4 "$f" | grep -q ELF; then cp "$f" /export/bin/; continue; fi; \
      case "$(head -1 "$f")" in '#!/usr/bin/env bash'|'#!/usr/bin/env sh') cp "$f" /export/bin/;; esac; \
    done

# node 22 on Debian bookworm
FROM docker.io/library/node:22-bookworm@sha256:7702d8aa4d5910871692af4480eb3ba86f23047a6417a44d857d06c95d060d3f
USER 0
COPY --from=tools /export/bin/ /opt/tools/bin/
COPY --from=tools /usr/local/go /usr/local/go
COPY install-tools.sh verify-tools.sh checks.txt /tmp/build/
RUN sh /tmp/build/install-tools.sh
# Claude Code refuses its Bash tool without SHELL; node's own binaries win over the tools image
ENV HOME=/home/agent SHELL=/bin/bash \
    PATH=/usr/local/bin:/opt/venv/bin:/opt/tools/bin:/usr/local/go/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    DISABLE_AUTOUPDATER=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false
USER 10001:0
RUN sh /tmp/build/verify-tools.sh
USER 0
RUN rm -rf /tmp/build
USER 10001:0
WORKDIR /home/agent
ENTRYPOINT ["tini", "--", "/usr/local/bin/agent-uid-entrypoint"]
CMD ["claude", "--version"]
