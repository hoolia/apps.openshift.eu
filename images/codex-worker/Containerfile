# Codex review worker; build context is the repository root (images/coding-agent tools)
FROM docker.io/library/node:22-bookworm@sha256:7702d8aa4d5910871692af4480eb3ba86f23047a6417a44d857d06c95d060d3f AS tooling
WORKDIR /build
COPY images/codex-worker/scripts ./scripts
# pinned Codex CLI, checked against its sha256 and exercised natively
RUN env -i PATH="$PATH" HOME=/tmp sh scripts/prepare-codex.sh
# worker, agent and client suites, one file at a time; a failure fails the build
RUN env -i PATH="$PATH" HOME=/tmp node --test --test-concurrency=1 --test-timeout=180000 \
      scripts/codex-chatgpt.test.mjs scripts/codex-exec-agent.test.mjs \
      scripts/codex-worker.test.mjs scripts/codex-worker-recovery.test.mjs \
      scripts/codex-worker-tls.test.mjs

FROM docker.io/library/node:22-bookworm@sha256:7702d8aa4d5910871692af4480eb3ba86f23047a6417a44d857d06c95d060d3f
USER 0
# the tools of the coding-agent images, pinned and checked there
COPY images/coding-agent/install-tools.sh images/coding-agent/verify-tools.sh images/coding-agent/checks-common.txt /tmp/build/
RUN sh /tmp/build/install-tools.sh && chgrp -R 0 /home/agent && chmod -R g=u /home/agent
COPY --from=tooling --chmod=0555 /build/codex-tooling/codex /usr/local/bin/codex
WORKDIR /app
COPY images/codex-worker/scripts/codex-chatgpt.mjs images/codex-worker/scripts/codex-exec-agent.mjs images/codex-worker/scripts/codex-run-lock.py images/codex-worker/scripts/codex-worker.mjs images/codex-worker/scripts/codex-worker-lock.py images/codex-worker/scripts/codex-worker-client.mjs images/codex-worker/scripts/codex-review.schema.json ./scripts/
ENV HOME=/home/agent SHELL=/bin/bash \
    PATH=/usr/local/bin:/opt/venv/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    NODE_ENV=production \
    CODEX_WORKER_HOST=0.0.0.0 \
    CODEX_WORKER_PORT=3443 \
    CODEX_AUTH_STATE_DIR=/var/lib/codex/state \
    CODEX_EXCHANGE_DIR=/var/lib/codex/exchange \
    CODEX_AGENT_URL=http://127.0.0.1:3444
USER 10001:0
RUN sh /tmp/build/verify-tools.sh /tmp/build/checks-common.txt && codex --version
USER 0
RUN rm -rf /tmp/build
USER 10001:0
EXPOSE 3443
# worker container; the codex container runs: node scripts/codex-exec-agent.mjs
ENTRYPOINT ["python3", "scripts/codex-worker-lock.py", "node", "scripts/codex-worker.mjs"]
