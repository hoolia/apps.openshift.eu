general: {
    configs_folder = "/etc/janus"
    plugins_folder = "/usr/local/lib/janus/plugins"
    transports_folder = "/usr/local/lib/janus/transports"
    events_folder = "/usr/local/lib/janus/events"
    loggers_folder = "/usr/local/lib/janus/loggers"
    log_to_stdout = true
    debug_colors = false
    interface = "127.0.0.1"
}
media: {
    ipv6 = false
    rtp_port_range = "20000-39999"
}
nat: {
    ice_tcp = false
    ice_enforce_list = "127.0.0.1"
}
events: {
    broadcast = true
}
